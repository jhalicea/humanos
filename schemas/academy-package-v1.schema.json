{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanos.local/schemas/academy-package-v1.schema.json",
  "title": "HumanOS Academy Package v1",
  "type": "object",
  "required": ["schema", "package_id", "title", "version", "skills", "courses"],
  "properties": {
    "schema": {"const": "humanos.academy.package.v1"},
    "package_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill_id", "title"],
        "properties": {
          "skill_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "domains": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "prerequisites": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "concepts": {"type": "array"},
          "exercises": {"type": "array"},
          "assessments": {"type": "array"}
        },
        "additionalProperties": true
      }
    },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["course_id", "title", "modules"],
        "properties": {
          "course_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "modules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["module_id", "title", "skill_ids"],
              "properties": {
                "module_id": {"type": "string", "minLength": 1},
                "title": {"type": "string", "minLength": 1},
                "description": {"type": "string"},
                "skill_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
              }
            }
          },
          "labs": {"type": "array"},
          "certifications": {"type": "array"}
        },
        "additionalProperties": true
      }
    },
    "job_packs": {"type": "array"},
    "resources": {"type": "array"}
  },
  "additionalProperties": true
}
