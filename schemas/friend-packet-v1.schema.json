{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanos.local/schemas/friend-packet-v1.json",
  "title": "HumanOS FRIEND Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "packet_id", "work_order_id", "baseline_commit_sha",
    "worker_role", "privacy_classification", "task", "known_evidence", "constraints",
    "unknown_do_not_assume", "allowed_scope", "prohibited_actions",
    "acceptance_criteria", "expected_output", "verification_required", "ownership",
    "content_authority", "output_trust"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "FRIEND_PACKET"},
    "packet_id": {"type": "string", "minLength": 1},
    "work_order_id": {"type": "string", "minLength": 1},
    "baseline_commit_sha": {"type": "string", "pattern": "^[0-9A-Fa-f]{40}$"},
    "worker_role": {"type": "string", "minLength": 1},
    "privacy_classification": {
      "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED", "LOCAL_ONLY"]
    },
    "task": {"type": "string", "minLength": 1},
    "known_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unknown_do_not_assume": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "allowed_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "prohibited_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "expected_output": {"type": "string", "minLength": 1},
    "verification_required": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "paths"],
      "properties": {
        "mode": {"enum": ["READ_ONLY", "BOUNDED_WRITE"]},
        "paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "content_authority": {"const": "DATA_ONLY"},
    "output_trust": {"const": "PROPOSAL_UNVERIFIED"}
  }
}
