{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanos.local/schemas/friend-assignment-v1.json",
  "title": "HumanOS FRIEND Assignment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "packet_id", "worker_role", "task",
    "known_evidence", "allowed_paths", "expected_output",
    "verification_required", "ownership_mode"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "FRIEND_ASSIGNMENT"},
    "packet_id": {"type": "string", "minLength": 1},
    "worker_role": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "known_evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "expected_output": {"type": "string", "minLength": 1},
    "verification_required": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "ownership_mode": {"enum": ["READ_ONLY", "BOUNDED_WRITE"]}
  }
}
