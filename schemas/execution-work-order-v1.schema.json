{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanos.local/schemas/execution-work-order-v1.json",
  "title": "HumanOS Execution Work Order v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "work_order_id", "status", "objective", "scope",
    "out_of_scope", "baseline", "relevant_files", "constraints", "acceptance_tests",
    "security_requirements", "rollback", "assigned_workers", "known_unknowns",
    "provenance_references", "done_condition", "approval", "privacy_classification"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "EXECUTION_WORK_ORDER"},
    "work_order_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "APPROVED", "STALE", "COMPLETE"]},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit_sha"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9A-Fa-f]{40}$"}
      }
    },
    "relevant_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptance_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "security_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rollback": {"type": "string", "minLength": 1},
    "assigned_workers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "known_unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "provenance_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "reference"],
        "properties": {
          "type": {"enum": ["decision", "file", "commit", "test", "artifact", "source"]},
          "reference": {"type": "string", "minLength": 1}
        }
      }
    },
    "done_condition": {"type": "string", "minLength": 1},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_by", "approved_at"],
      "properties": {
        "approved_by": {"type": "string"},
        "approved_at": {"type": "string"}
      }
    },
    "privacy_classification": {
      "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED", "LOCAL_ONLY"]
    }
  }
}
