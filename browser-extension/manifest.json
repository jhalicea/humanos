{
  "manifest_version": 3,
  "name": "HumanOS Browser Bridge",
  "version": "0.1.0",
  "description": "Executes broker-approved HumanOS browser actions on a selected tab.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "HumanOS: select this tab"
  },
  "key": ""
}
